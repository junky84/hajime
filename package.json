{
  "name": "hajime",
  "productName": "Hajime",
  "version": "1.5.0",
  "description": "Hajime – Judo-Anzeigetafel mit Publikums- und Bedienfenster",
  "main": "main.js",
  "author": "junky84",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/core.test.js && node test/brackets.test.js && node test/mats.test.js && node test/excel.test.js && node test/training.test.js && node test/team.test.js && node test/net.test.js && node test/i18n.test.js",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "build:web": "node scripts/build-web.js"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.junky84.hajime",
    "productName": "Hajime",
    "copyright": "junky84",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "hub.js",
      "package.json",
      "src/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.sports",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Hajime-${version}-Mac.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Hajime-${version}-Windows.${ext}"
    },
    "portable": {
      "artifactName": "Hajime-${version}-Windows-portable.exe",
      "splashImage": "build/splash.bmp"
    }
  }
}
