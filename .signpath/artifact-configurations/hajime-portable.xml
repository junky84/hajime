<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath-Artefaktkonfiguration „hajime-portable“: signiert die portable Hajime-x.y.z-Windows-portable.exe
  (die Datei, die man herunterlädt und startet). Sie enthält die bereits signierte Hajime.exe.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Hajime-${version}-Windows-portable.exe" product-name="Hajime" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
